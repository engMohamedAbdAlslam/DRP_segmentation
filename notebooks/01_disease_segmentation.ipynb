    {
      "cell_type": "markdown",
      "id": "cb84748b",
      "metadata": {},
      "source": [
        "## Download IDRiD from Kaggle\n",
        "If the slug below fails, replace it with the dataset you have access to on Kaggle.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 4,
      "id": "1e37f5df",
      "metadata": {},
      "outputs": [],
      "source": [
        "import zipfile\n",
        "\n",
        "idrid_slug = \"mostafaabla/idrid-segmentation\"\n",
        "idrid_root = raw_dir / \"idrid\"\n",
        "idrid_root.mkdir(parents=True, exist_ok=True)\n",
        "archive_path = idrid_root / \"idrid.zip\"\n",
        "\n",
        "if not any(idrid_root.rglob(\"*.png\")) and not any(idrid_root.rglob(\"*.jpg\")):\n",
        "    if not archive_path.exists():\n",
        "        subprocess.run([\"kaggle\", \"datasets\", \"download\", \"-d\", idrid_slug, \"-p\", str(idrid_root)], check=True)\n",
        "    if archive_path.exists():\n",
        "        with zipfile.ZipFile(archive_path, \"r\") as zip_ref:\n",
        "            zip_ref.extractall(idrid_root)\n",
        "    print(\"IDRiD extracted to\", idrid_root)\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Index images and lesion masks\n",
        "The helper below attempts to pair images with all lesion masks that share the same stem.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "from sklearn.model_selection import train_test_split\n",
        "\n",
        "IMAGE_EXTS = {\".png\", \".jpg\", \".jpeg\", \".tif\", \".tiff\"}\n",
        "LESION_SUFFIXES = {\"EX\", \"HE\", \"MA\", \"SE\", \"NV\", \"IRMA\", \"HARD\", \"SOFT\"}\n",
        "\n",
        "def _is_mask_path(path):\n",
        "    tokens = \" \".join([path.name.lower()] + [p.name.lower() for p in path.parents])\n",
        "    return any(key in tokens for key in [\"mask\", \"groundtruth\", \"segmentation\", \"lesion\", \"gt\"])\n",
        "\n",
        "def _mask_key(path):\n",
        "    parts = path.stem.split(\"_\")\n",
        "    if parts and parts[-1].upper() in LESION_SUFFIXES:\n",
        "        return \"_\".join(parts[:-1])\n",
        "    return path.stem\n",
        "\n",
        "def find_images_and_masks(root):\n",
        "    image_files = [p for p in root.rglob(\"*\") if p.suffix.lower() in IMAGE_EXTS and not _is_mask_path(p)]\n",
        "    mask_files = [p for p in root.rglob(\"*\") if p.suffix.lower() in IMAGE_EXTS and _is_mask_path(p)]\n",
        "    mask_map = {}\n",
        "    for mask in mask_files:\n",
        "        key = _mask_key(mask)\n",
        "        mask_map.setdefault(key, []).append(mask)\n",
        "    rows = []\n",
        "    for image in sorted(image_files):\n",
        "        rows.append({\"image_path\": image, \"mask_paths\": mask_map.get(image.stem, [])})\n",
        "    return pd.DataFrame(rows)\n",
        "\n",
        "idrid_df = find_images_and_masks(idrid_root)\n",
        "print(\"Images:\", len(idrid_df), \"with masks:\", idrid_df[\"mask_paths\"].apply(bool).sum())\n",
        "\n",
        "if not idrid_df.empty:\n",
        "    train_df, temp_df = train_test_split(idrid_df, test_size=0.3, random_state=42)\n",
        "    val_df, test_df = train_test_split(temp_df, test_size=0.5, random_state=42)\n",
        "    print(\"Train/Val/Test:\", len(train_df), len(val_df), len(test_df))\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Preprocess and visualize a sample\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "def load_combined_mask(mask_paths, target_shape):\n",
        "    if not mask_paths:\n",
        "        return None\n",
        "    combined = np.zeros(target_shape[:2], dtype=np.uint8)\n",
        "    for mask_path in mask_paths:\n",
        "        mask = cv2.imread(str(mask_path), cv2.IMREAD_GRAYSCALE)\n",
        "        if mask is None:\n",
        "            continue\n",
        "        combined = np.maximum(combined, mask)\n",
        "    return combined\n",
        "\n",
        "if not idrid_df.empty:\n",
        "    sample = idrid_df.iloc[0]\n",
        "    image_array = cv2.imread(str(sample[\"image_path\"]))\n",
        "    if image_array is None:\n",
        "        print(\"Failed to read\", sample[\"image_path\"])\n",
        "    else:\n",
        "        config = PreprocessConfig(target_size=(512, 512), normalization=\"zero_one\")\n",
        "        combined_mask = load_combined_mask(sample[\"mask_paths\"], image_array.shape)\n",
        "        result = preprocess_fundus_image(sample[\"image_path\"], mask=combined_mask, config=config)\n",
        "        fig, axes = plt.subplots(1, 3, figsize=(12, 4))\n",
        "        original = cv2.cvtColor(image_array, cv2.COLOR_BGR2RGB)\n",
        "        axes[0].imshow(original)\n",
        "        axes[0].set_title(\"Original\")\n",
        "        axes[0].axis(\"off\")\n",
        "        axes[1].imshow(result.image)\n",
        "        axes[1].set_title(\"Preprocessed\")\n",
        "        axes[1].axis(\"off\")\n",
        "        if result.mask is not None:\n",
        "            axes[2].imshow(result.mask, cmap=\"gray\")\n",
        "            axes[2].set_title(\"Combined Mask\")\n",
        "            axes[2].axis(\"off\")\n",
        "        else:\n",
        "            axes[2].axis(\"off\")\n",
        "        plt.tight_layout()\n"
      ]
    },
    {
